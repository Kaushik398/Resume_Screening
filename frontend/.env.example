# Supabase Credentials for React Frontend
# Copy this file to `.env` or `.env.local` to enable real Supabase authentication.
# If these variables are not provided, the application will run in Demo Auth Mode.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
